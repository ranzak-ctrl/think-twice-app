{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npx vitest run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git describe:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(npx vercel ls:*)",
      "Bash(npx vercel inspect:*)",
      "Bash(npx vercel logs:*)",
      "Bash(npx vercel env ls:*)",
      "Bash(npx vercel project ls:*)",
      "Bash(npx vercel whoami)",
      "Bash(npx vercel build:*)",
      "Bash(curl -s -o /dev/null -w:*)",
      "Bash(curl -sI:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.local-backup)",
      "Read(./.vercel/.env.production.local)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
