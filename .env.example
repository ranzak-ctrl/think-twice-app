# ── Server-only secrets (never VITE_-prefixed, never in the browser) ──
# Set these in the Vercel project environment, NOT in a local .env that the
# client build can see. The serverless proxy (api/anthropic/v1/messages.js)
# reads them at request time and injects the key upstream.
ANTHROPIC_API_KEY=
APP_PASSWORD=

# ── Client (VITE_-prefixed = inlined into the bundle — NEVER a secret) ─
# VITE_USE_MOCK=true  runs the scripted mock adapter (local dev + tests).
# VITE_USE_MOCK=false runs live through the proxy above. Live is the default:
# anything other than the exact string "true" means live.
VITE_USE_MOCK=false
VITE_MODEL=claude-haiku-4-5

# Show the shared access-password gate (pairs with APP_PASSWORD above).
VITE_REQUIRE_PASSWORD=1
