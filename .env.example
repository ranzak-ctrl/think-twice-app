# ── Local development (.env, git-ignored) ─────────────────────────────
# Direct key for local dev only. The vite dev-server proxy forwards it.
VITE_ANTHROPIC_API_KEY=sk-ant-...
VITE_MODEL=claude-sonnet-4-6

# ── Production / deployed (set in Vercel, NOT here) ───────────────────
# Client (safe to expose — NOT secrets):
#   VITE_LIVE=1                 # enable live mode without a client-side key
#   VITE_REQUIRE_PASSWORD=1     # show the access-password gate
# Server-only (secret — set in Vercel env, never VITE_-prefixed):
#   ANTHROPIC_API_KEY=sk-ant-...   # the real key, injected by the proxy
#   APP_PASSWORD=<shared tester password>
